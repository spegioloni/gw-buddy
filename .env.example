# Kopie dieser Datei nach ".env" anlegen und mit echten Werten befuellen.
# ".env" selbst ist in .gitignore eingetragen und wird nicht committet.

GW_SUPABASE_EMAIL=deine@mail.de
GW_SUPABASE_PASSWORD=deinPasswort

